<aside data-controller="preview"
        data-preview-zoom-value="<%= @config&.dig('preview_zoom') || 100 %>"
        data-action="preview:zoom-changed->app#onPreviewZoomChanged preview:zoom-changed->scroll-sync#onPreviewZoomChanged preview:toggled->app#onPreviewToggled preview:toggled->scroll-sync#onPreviewToggled preview:scroll->scroll-sync#onPreviewScroll preview:programmatic-scroll->scroll-sync#onProgrammaticPreviewScroll preview:toggle-task->app#onPreviewToggleTask"
        class="flex-none w-[40%] border-l border-[var(--theme-border)] flex-col bg-[var(--theme-bg-primary)] hidden"
        data-preview-target="panel"
        data-app-target="previewPanel">
    <!-- Preview Content -->
    <span class="hidden" data-preview-target="zoomLevel" aria-hidden="true">100%</span>
    <div class="relative flex-1 overflow-y-auto p-6 prose prose-zinc dark:prose-invert prose-sm max-w-none"
         data-preview-target="content"
         data-app-target="previewContent"
         data-action="scroll->preview#onPreviewScroll click->preview#onContentClick">
    </div>
</aside>
