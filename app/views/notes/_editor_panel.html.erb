<main class="flex-1 flex flex-col min-w-0 relative" data-app-target="editorPanel">
  <span class="workspace-table-hint hidden" data-app-target="tableHint"><%= t('editor.cursor_in_table') %></span>
  <!-- Editor Container -->
  <div class="flex-1 overflow-hidden" data-app-target="editorContainer">
    <div class="h-full overflow-y-auto" data-app-target="editorPlaceholder">
      <%= render "notes/home" %>
    </div>
    <div class="h-full hidden relative" data-app-target="editor"
         data-controller="codemirror typewriter"
         data-action="codemirror:ready->app#onCodemirrorReady codemirror:change->app#onEditorChange codemirror:selection-change->app#onEditorSelectionChange codemirror:scroll->scroll-sync#onEditorScroll codemirror:image-pasted->app#onImagePaste codemirror:vim-command->app#onVimCommand codemirror:vim-mode->app#onVimModeStatus typewriter:toggled->app#onTypewriterToggled">
      <div class="h-full flex editor-wrapper" data-app-target="editorWrapper" data-typewriter-target="wrapper">
        <div class="flex-1 h-full editor-body" data-app-target="editorBody" data-typewriter-target="body">
          <!-- CodeMirror container -->
          <div class="h-full cm-editor-container"
               data-codemirror-target="container"
               data-typewriter-target="editor"
               data-action="contextmenu->app#onTextareaContextMenu">
          </div>
          <!-- Hidden textarea for form submission and backward compatibility -->
          <textarea
            data-app-target="textarea"
            data-codemirror-target="hidden"
            data-connection-monitor-target="textarea"
            class="hidden"
            name="document[content]"
          ></textarea>
          <!-- Vim mode indicator (hidden unless vim mode is on) -->
          <div
            data-app-target="vimStatus"
            class="hidden absolute bottom-1 right-2 z-10 px-1.5 py-0.5 rounded text-[11px] font-medium tracking-wide bg-[var(--theme-bg-tertiary)] text-[var(--theme-text-muted)] pointer-events-none select-none"
          ></div>
        </div>
      </div>
    </div>
  </div>
</main>
