<button
  type="button"
  data-action="click->app#toggleLibrary"
  data-app-target="libraryToggle"
  class="library-toggle flex items-center gap-1.5 px-2 py-1.5 rounded hover:bg-[var(--theme-bg-hover)] text-[var(--theme-text-muted)]"
  title="<%= t('header.open_library') %>"
  aria-pressed="false"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 3h16a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8" />
  </svg>
  <span class="text-xs"><%= t('header.library') %></span>
</button>
