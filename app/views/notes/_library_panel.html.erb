<section
  class="flex-1 min-w-0 hidden overflow-y-auto bg-[var(--theme-bg-primary)]"
  data-app-target="libraryPanel"
  data-controller="library"
  aria-labelledby="library-title"
>
  <div class="library-workspace mx-auto w-full max-w-7xl p-4 sm:p-6 lg:p-8">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 id="library-title" class="text-xl font-semibold"><%= t('library.title') %></h1>
        <p class="mt-1 text-sm text-[var(--theme-text-muted)]"><%= t('library.description') %></p>
      </div>
      <button
        type="button"
        data-action="click->library#closeLibrary"
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-[var(--theme-border)] text-[var(--theme-text-secondary)] hover:bg-[var(--theme-bg-hover)]"
        aria-label="<%= t('common.close') %>"
        title="<%= t('common.close') %>"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="mt-6 flex items-center gap-2 border-b border-[var(--theme-border)]" role="group" aria-label="<%= t('library.categories') %>">
      <button
        type="button"
        data-library-target="imagesTab"
        data-action="click->library#showImages"
        aria-pressed="true"
        class="library-tab px-3 py-2 text-sm font-medium text-[var(--theme-accent)]"
      ><%= t('library.images') %></button>
      <button
        type="button"
        data-library-target="videosTab"
        data-action="click->library#showVideos"
        aria-pressed="false"
        class="library-tab px-3 py-2 text-sm font-medium text-[var(--theme-text-muted)]"
      ><%= t('library.videos') %></button>
      <span class="ml-auto pb-2 text-xs text-[var(--theme-text-faint)]" data-library-target="count"></span>
    </div>

    <div class="mt-4 flex flex-col gap-3 sm:flex-row">
      <label class="sr-only" for="library-search"><%= t('library.search') %></label>
      <input
        id="library-search"
        type="search"
        data-library-target="search"
        data-action="input->library#render"
        placeholder="<%= t('library.search') %>"
        class="min-w-0 flex-1 rounded-md border border-[var(--theme-border)] bg-[var(--theme-bg-secondary)] px-3 py-2 text-sm text-[var(--theme-text-primary)] placeholder:text-[var(--theme-text-muted)] focus:border-[var(--theme-accent)] focus:outline-none"
      >
      <label class="sr-only" for="library-sort"><%= t('library.sort_by') %></label>
      <select
        id="library-sort"
        data-library-target="sort"
        data-action="change->library#render"
        aria-label="<%= t('library.sort_by') %>"
        class="rounded-md border border-[var(--theme-border)] bg-[var(--theme-bg-secondary)] px-3 py-2 text-sm text-[var(--theme-text-primary)] focus:border-[var(--theme-accent)] focus:outline-none"
      >
        <option value="newest"><%= t('library.sort_newest') %></option>
        <option value="oldest"><%= t('library.sort_oldest') %></option>
        <option value="name"><%= t('library.sort_name') %></option>
      </select>
    </div>

    <p class="hidden mt-4 rounded-md border border-[var(--theme-error)] px-3 py-2 text-sm text-[var(--theme-error)]" data-library-target="error" role="alert"></p>
    <p class="hidden mt-4 text-sm text-[var(--theme-text-muted)]" data-library-target="loading" role="status"><%= t('library.loading') %></p>
    <p class="hidden mt-3 text-sm text-[var(--theme-text-muted)]" data-library-target="status" role="status" aria-live="polite"></p>
    <div class="library-grid mt-5" data-library-target="grid" aria-live="polite"></div>

    <div
      class="hidden fixed inset-0 z-50 items-center justify-center bg-black/70 p-4"
      data-library-target="previewDialog"
      data-action="click->library#closePreviewOnBackdrop"
      role="dialog"
      aria-modal="true"
      aria-labelledby="library-preview-name"
    >
      <div class="library-preview-dialog w-full max-w-5xl max-h-[90vh] overflow-y-auto rounded-xl border border-[var(--theme-border)] bg-[var(--theme-bg-secondary)] shadow-2xl" data-library-preview-content>
        <div class="flex items-start justify-between gap-4 border-b border-[var(--theme-border)] p-4 sm:p-5">
          <div class="min-w-0">
            <h2 id="library-preview-name" class="truncate text-base font-semibold" data-library-target="previewName"></h2>
            <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-[var(--theme-text-muted)]">
              <p data-library-target="previewUsage"></p>
              <span aria-hidden="true">·</span>
              <p data-library-target="previewMetadata"></p>
            </div>
          </div>
          <button type="button" data-action="click->library#closePreview" class="rounded p-1.5 text-[var(--theme-text-muted)] hover:bg-[var(--theme-bg-hover)]" aria-label="<%= t('common.close') %>">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" stroke-width="2" /></svg>
          </button>
        </div>
        <div class="library-preview-media flex min-h-48 items-center justify-center p-4 sm:p-6" data-library-target="previewMedia"></div>
        <div class="flex flex-wrap justify-end gap-2 border-t border-[var(--theme-border)] p-4 sm:p-5">
          <button type="button" data-action="click->library#deletePreviewItem" class="rounded-md border border-[var(--theme-error)] px-3 py-2 text-sm text-[var(--theme-error)] hover:bg-[var(--theme-bg-hover)]"><%= t('library.delete') %></button>
          <button type="button" data-action="click->library#copyPreviewPath" class="rounded-md border border-[var(--theme-border)] px-3 py-2 text-sm text-[var(--theme-text-secondary)] hover:bg-[var(--theme-bg-hover)]"><%= t('library.copy_path') %></button>
          <button type="button" data-action="click->library#insertPreviewItem" class="rounded-md bg-[var(--theme-accent)] px-3 py-2 text-sm font-medium text-[var(--theme-accent-text)] hover:opacity-90"><%= t('library.insert') %></button>
        </div>
      </div>
    </div>

    <div
      id="library-usage-dialog"
      class="hidden fixed inset-0 z-50 items-center justify-center bg-black/70 p-4"
      data-library-target="usageDialog"
      data-action="click->library#closeUsageDialogOnBackdrop keydown.esc->library#closeUsageDialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="library-usage-dialog-title"
    >
      <div class="w-full max-w-lg max-h-[80vh] overflow-y-auto rounded-xl border border-[var(--theme-border)] bg-[var(--theme-bg-secondary)] shadow-2xl" data-library-usage-content>
        <div class="flex items-start justify-between gap-4 border-b border-[var(--theme-border)] p-4 sm:p-5">
          <h2 id="library-usage-dialog-title" class="min-w-0 text-base font-semibold" data-library-target="usageDialogTitle"></h2>
          <button
            type="button"
            data-library-target="usageDialogClose"
            data-action="click->library#closeUsageDialog"
            class="rounded p-1.5 text-[var(--theme-text-muted)] hover:bg-[var(--theme-bg-hover)]"
            aria-label="<%= t('common.close') %>"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" stroke-width="2" /></svg>
          </button>
        </div>
        <ul class="max-h-[60vh] space-y-1 overflow-y-auto p-4 sm:p-5" data-library-target="usageNotes" aria-live="polite"></ul>
      </div>
    </div>
  </div>
</section>
