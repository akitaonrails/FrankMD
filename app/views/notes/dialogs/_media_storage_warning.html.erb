<dialog data-media-storage-target="warningDialog" role="alertdialog" aria-modal="true"
        aria-labelledby="media-storage-warning-title" aria-describedby="media-storage-warning-message"
        class="w-[calc(100%-2rem)] max-w-md rounded-lg border border-[var(--theme-border)] bg-[var(--theme-bg-secondary)] p-6 text-[var(--theme-text-primary)] shadow-xl backdrop:bg-black/50">
  <h2 id="media-storage-warning-title" class="text-lg font-semibold text-[var(--theme-warning)]"><%= t("media_storage.recovery_title") %></h2>
  <p id="media-storage-warning-message" class="mt-3 text-sm"><%= t("media_storage.recovered") %></p>
  <div class="mt-4 flex justify-end">
    <button type="button" data-action="click->media-storage#dismissWarning"
            class="rounded-md border border-[var(--theme-border)] bg-[var(--theme-bg-primary)] px-4 py-2 text-sm hover:bg-[var(--theme-bg-hover)]"><%= t("common.ok") %></button>
  </div>
</dialog>
