<div
  class="frankmd-menu fixed hidden bg-[var(--theme-bg-secondary)] border border-[var(--theme-border)] rounded-lg shadow-lg py-1 min-w-[180px] z-50 text-[var(--theme-text-primary)]"
  data-app-target="explorerMenu"
  role="menu"
  aria-label="<%= t('context_menu.explorer_menu') %>"
>
  <button
    type="button"
    role="menuitem"
    data-action="click->app#newNote click->app#hideExplorerMenu"
    class="w-full px-3 py-1.5 text-left text-sm hover:bg-[var(--theme-bg-hover)] flex items-center gap-2"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
    </svg>
    <%= t('context_menu.new_note') %>
  </button>
  <button
    type="button"
    role="menuitem"
    data-action="click->app#newFolder click->app#hideExplorerMenu"
    class="w-full px-3 py-1.5 text-left text-sm hover:bg-[var(--theme-bg-hover)] flex items-center gap-2"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m-2-13H5a2 2 0 00-2 2v12a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-6l-2-2z" />
    </svg>
    <%= t('context_menu.new_folder') %>
  </button>
  <button
    type="button"
    role="menuitem"
    data-action="click->app#selectAllExplorerItems"
    class="w-full px-3 py-1.5 text-left text-sm hover:bg-[var(--theme-bg-hover)] flex items-center gap-2"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 11l3 3L22 4M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" />
    </svg>
    <%= t('context_menu.select_all') %>
  </button>
  <button
    type="button"
    role="menuitem"
    data-action="click->app#openFileFinder click->app#hideExplorerMenu"
    class="w-full px-3 py-1.5 text-left text-sm hover:bg-[var(--theme-bg-hover)] flex items-center gap-2"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <%= t('sidebar.find_file') %>
  </button>
</div>
