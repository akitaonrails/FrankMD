<dialog
  class="w-80 max-w-[calc(100vw-2rem)] p-0 rounded-lg shadow-xl backdrop:bg-black/50 bg-[var(--theme-bg-secondary)] border border-[var(--theme-border)]"
  data-app-target="undoCreatedNoteDialog"
  aria-labelledby="undo-created-note-title"
  aria-describedby="undo-created-note-message"
>
  <form method="dialog" class="p-4 text-[var(--theme-text-primary)]">
    <%= render "shared/dialog_header",
      title: t('confirm.undo_created_note_title'),
      title_id: "undo-created-note-title",
      close_action: "click->app#closeUndoCreatedNoteDialog",
      close_label: t('common.close') %>
    <p
      id="undo-created-note-message"
      data-app-target="undoCreatedNoteMessage"
      class="text-sm leading-relaxed text-[var(--theme-text-secondary)]"
    ></p>
    <div class="mt-4 flex justify-end gap-2">
      <%= render "shared/button_secondary", label: t('common.cancel'), type: "submit", value: "cancel", autofocus: true %>
      <button
        type="submit"
        value="confirm"
        class="px-3 py-1.5 text-sm rounded-md border border-[var(--theme-error)] text-[var(--theme-error)] hover:bg-[var(--theme-bg-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--theme-error)]"
      ><%= t('common.delete') %></button>
    </div>
  </form>
</dialog>
