<div class="workspace-explorer-actions" role="group" aria-label="<%= t('sidebar.explorer') %>">
  <div class="workspace-global-actions">
    <button type="button" class="workspace-icon" data-action="click->app#newNote" title="<%= t('sidebar.new_note') %>" aria-label="<%= t('sidebar.new_note') %>">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
    </button>
    <button type="button" class="workspace-icon" data-action="click->app#newFolder" title="<%= t('sidebar.new_folder') %>" aria-label="<%= t('sidebar.new_folder') %>">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m-9 1V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z" /></svg>
    </button>
    <button type="button" class="workspace-icon" data-action="click->app#openFileFinder" title="<%= t('sidebar.find_file') %>" aria-label="<%= t('sidebar.find_file') %>">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
    </button>
    <button type="button" class="workspace-icon" data-action="click->app#openContentSearch" title="<%= t('sidebar.search_in_files') %>" aria-label="<%= t('sidebar.search_in_files') %>">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16l2.879-2.879m0 0a3 3 0 104.243-4.242 3 3 0 00-4.243 4.242zM21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
    </button>
  </div>
  <button type="button" class="workspace-icon" data-action="click->app#toggleSidebar" data-app-target="sidebarToggle" aria-controls="workspace-explorer" aria-expanded="true" title="<%= t('header.toggle_explorer') %>" aria-label="<%= t('header.toggle_explorer') %>">
    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
  </button>
</div>
