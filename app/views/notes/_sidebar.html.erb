<aside id="workspace-sidebar" class="workspace-sidebar" data-app-target="sidebar">
  <header class="workspace-sidebar-header">
    <button type="button" class="workspace-icon" data-action="click->app#toggleSidebar" data-app-target="sidebarToggle" aria-controls="workspace-sidebar" aria-expanded="true" title="<%= t('header.close_explorer') %>" aria-label="<%= t('header.close_explorer') %>">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M15 3v18"/><path d="m10 15-3-3 3-3"/></svg>
    </button>
    <%= render "notes/explorer_actions" %>
  </header>
  <div id="workspace-explorer" class="workspace-explorer" data-app-target="explorerPanel">
  <!-- File Tree -->
  <div
    id="file-tree-content"
    class="flex-1 overflow-y-auto p-2"
    data-app-target="fileTree"
    data-controller="drag-drop"
    data-drag-drop-target="tree"
    data-action="dragover->drag-drop#onDragOverRoot dragenter->drag-drop#onDragEnterRoot dragleave->drag-drop#onDragLeaveRoot drop->drag-drop#onDropToRoot drag-drop:item-moved->app#onItemMoved"
  >
    <%= render "notes/file_tree" %>
  </div>

  <!-- Document Stats Panel -->
  <div data-controller="stats-panel"
       class="flex-none border-t border-[var(--workspace-sidebar-border)] px-3 py-2 hidden"
       data-stats-panel-target="panel"
       data-app-target="statsPanel">
    <div class="grid grid-cols-2 gap-x-4 gap-y-1 text-xs">
      <div class="flex justify-between">
        <span class="text-[var(--theme-text-muted)]"><%= t('sidebar.words') %></span>
        <span class="text-[var(--theme-text-secondary)] font-medium" data-stats-panel-target="words">0</span>
      </div>
      <div class="flex justify-between">
        <span class="text-[var(--theme-text-muted)]"><%= t('sidebar.characters') %></span>
        <span class="text-[var(--theme-text-secondary)] font-medium" data-stats-panel-target="chars">0</span>
      </div>
      <div class="flex justify-between">
        <span class="text-[var(--theme-text-muted)]"><%= t('sidebar.size') %></span>
        <span class="text-[var(--theme-text-secondary)] font-medium" data-stats-panel-target="size">0 B</span>
      </div>
      <div class="flex justify-between">
        <span class="text-[var(--theme-text-muted)]"><%= t('sidebar.read_time') %></span>
        <span class="text-[var(--theme-text-secondary)] font-medium" data-stats-panel-target="readTime">0 min</span>
      </div>
      <div class="flex justify-between col-span-2">
        <span class="text-[var(--theme-text-muted)]"><%= t('sidebar.line') %></span>
        <span class="text-[var(--theme-text-secondary)] font-medium" data-stats-panel-target="linePosition">1/1</span>
      </div>
    </div>
  </div>

  </div>
  <footer class="workspace-sidebar-footer">
    <div class="workspace-brand">
      <img src="/icon.svg" class="w-5 h-5 shrink-0" alt="">
      <span><%= t('app.name') %></span>
    </div>
    <nav class="workspace-navigation" aria-label="<%= t('header.workspace_navigation') %>">
      <button type="button" class="workspace-icon" data-action="click->app#showHome" aria-label="<%= t('home.title') %>" title="<%= t('home.title') %>">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z"/></svg>
      </button>
      <%= render "notes/library_button" %>
      <%= render "notes/settings_button" %>
    </nav>
  </footer>
</aside>
