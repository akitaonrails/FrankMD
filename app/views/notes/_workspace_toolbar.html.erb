<div class="workspace-toolbar" role="group" aria-label="<%= t('header.document_actions') %>">
  <div class="hidden items-center" data-app-target="editorToolbar">
<button type="button" class="workspace-icon" data-action="click->app#openImagePicker" title="<%= t('editor.toolbar.image_title') %>" aria-label="<%= t('editor.toolbar.image_title') %>"><svg aria-hidden="true" class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg></button>
<button type="button" class="workspace-icon" data-action="click->app#openFindReplace" title="<%= t('editor.toolbar.find_title') %>" aria-label="<%= t('editor.toolbar.find_title') %>"><svg aria-hidden="true" class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg></button>
  </div>
<button type="button" class="workspace-icon" data-action="click->app#togglePreview" title="<%= t('header.toggle_preview') %>" aria-label="<%= t('header.toggle_preview') %>" data-app-target="previewToggle" aria-pressed="false" disabled><svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
      </svg></button>
  <div class="relative" data-app-target="overflowContainer" data-action="keydown->app#navigateWorkspaceMenu">
    <button type="button" class="workspace-icon" data-app-target="overflowToggle" data-action="click->app#toggleWorkspaceMenu" aria-expanded="false" aria-haspopup="menu" aria-controls="workspace-menu" title="<%= t('header.more_actions') %>" aria-label="<%= t('header.more_actions') %>"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg></button>
    <div id="workspace-menu" role="menu" aria-label="<%= t('header.more_actions') %>" data-app-target="overflowMenu" class="hidden frankmd-menu workspace-menu">
      <button type="button" role="menuitem" tabindex="-1" data-workspace-editing-action data-action="click->app#closeWorkspaceMenu click->app#openVideoDialog" ><svg aria-hidden="true" class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg><span><%= t('editor.toolbar.video_title') %></span></button>
      <button type="button" role="menuitem" tabindex="-1" data-workspace-editing-action data-action="click->app#closeWorkspaceMenu click->app#openCodeEditor" ><svg aria-hidden="true" class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
      </svg><span><%= t('editor.toolbar.code_title') %></span></button>
      <button type="button" role="menuitem" tabindex="-1" data-workspace-editing-action data-action="click->app#closeWorkspaceMenu click->app#openTableEditor" ><svg aria-hidden="true" class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18M10 3v18M14 3v18M3 6a3 3 0 013-3h12a3 3 0 013 3v12a3 3 0 01-3 3H6a3 3 0 01-3-3V6z" />
      </svg><span><%= t('editor.toolbar.table_title') %></span></button>
      <button type="button" role="menuitem" tabindex="-1" data-workspace-editing-action data-action="click->app#closeWorkspaceMenu click->app#openEmojiPicker" ><svg aria-hidden="true" class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg><span><%= t('editor.toolbar.emoji_title') %></span></button>
      <button type="button" role="menuitem" tabindex="-1" data-workspace-editing-action data-action="click->app#closeWorkspaceMenu click->app#openAiDialog" data-app-target="aiButton"><svg aria-hidden="true" class="w-4 h-4 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"/>
        <circle cx="7.5" cy="14.5" r="1.5"/>
        <circle cx="16.5" cy="14.5" r="1.5"/>
      </svg><span><%= t('editor.toolbar.ai_title') %></span></button>
      <button type="button" role="menuitem" tabindex="-1" data-workspace-document-action data-action="click->app#closeWorkspaceMenu click->app#copyCurrentPath"><%= t('header.click_to_copy_path') %></button>
      <button type="button" role="menuitem" tabindex="-1" data-action="click->app#closeWorkspaceMenu click->app#openHelp"><%= t('editor.toolbar.help_title') %></button>
      <button type="button" role="menuitem" tabindex="-1" data-action="click->app#closeWorkspaceMenu click->app#openAboutDialog"><%= t('header.about_app') %></button>
    </div>
  </div>
</div>
